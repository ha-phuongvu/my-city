# Copy to .env (the repo root) and adjust. These match docker-compose.yml.

# PostgreSQL (local: docker compose; production: Neon)
DATABASE_URL=postgres://mycity:mycity@localhost:5432/mycity

# Meilisearch (local: docker compose; production: self-hosted on the Oracle Cloud free server)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=local-dev-master-key-change-me

# Redis for queues and rate limits (production: Upstash)
REDIS_URL=redis://localhost:6379

# S3-compatible storage for covers and images (local: RustFS; production: Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mycity
S3_SECRET_KEY=mycity-local-secret
S3_BUCKET=my-city

# Email (local: Mailpit catches everything at http://localhost:8025; production: Resend)
SMTP_URL=smtp://localhost:1025
